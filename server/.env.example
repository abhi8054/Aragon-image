DATABASE_URL=""
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Optional: point at a local S3-compatible service like MinIO for local dev
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
# Optional: Rekognition isn't offered in every region (e.g. eu-north-1). Set this
# to a supported region (eu-west-1, eu-central-1, us-east-1, ...) if your S3
# bucket lives somewhere Rekognition doesn't. Defaults to AWS_REGION.
REKOGNITION_REGION=""

# Validation thresholds
MIN_FILE_SIZE_BYTES=15000
MIN_IMAGE_DIMENSION_PX=400
BLUR_VARIANCE_THRESHOLD=80
MIN_FACE_AREA_RATIO=0.03
SIMILARITY_HAMMING_THRESHOLD=6
